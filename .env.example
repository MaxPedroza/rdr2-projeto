# ============================================
# RDR2 Tracker - Environment Configuration
# ============================================

# Backend Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# MongoDB (opcional para versão JSON)
MONGODB_URI=mongodb+srv://seu_usuario:sua_senha@seu_cluster.mongodb.net/rdr2_tracker_db?retryWrites=true&w=majority&appName=RDR2Tracker

# Frontend (development)
ANGULAR_API_URL=http://localhost:3000/api

# ============================================
# Produção (Render)
# ============================================
# PORT=3000
# NODE_ENV=production
# CORS_ORIGIN=https://rdr2-frontend.onrender.com
